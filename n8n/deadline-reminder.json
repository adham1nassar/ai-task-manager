    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nSELECT id, title, description, due_at, completed\nFROM tasks\nWHERE completed = FALSE\n  AND due_at IS NOT NULL\n  AND due_at >= NOW()\n  AND due_at < NOW() + INTERVAL '24 hours'\n  AND reminder_sent_at IS NULL\nORDER BY due_at ASC;",
        "options": {}
      },
